FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    wget \
    mysql-client \
    bzip2 \
    findutils \
    netcat-traditional \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Build context is the repo root (see docker-compose.yml), so paths are
# relative to the repo root, not this docker/ folder.
COPY docker/update-eve-data.sh /app/update-eve-data.sh
RUN chmod +x /app/update-eve-data.sh

COPY docker/init-db.sh /app/init-db.sh
RUN chmod +x /app/init-db.sh

# Ship the schema that actually matches this checkout instead of fetching it
# from roxlukas/lmeve on GitHub at container-build time.
COPY data/schema.sql /app/data/schema.sql

CMD ["/app/update-eve-data.sh"]
